# Server Network Accessibility
PORT=5000
# Set HOST to 0.0.0.0 to allow ESP32 and other devices on the same Wi-Fi/LAN to connect
HOST=0.0.0.0
NODE_ENV=development
# CORS Origin (comma-separated or * for development LAN testing)
CORS_ORIGIN=http://localhost:3000

# Device Telemetry (Offline timeout threshold in seconds)
HEARTBEAT_TIMEOUT_SECONDS=60

# MongoDB
# Local default or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017/netravaani
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/netravaani?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/netravaani
